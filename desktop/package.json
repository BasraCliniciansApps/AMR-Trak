{
  "name": "amr-trak-desktop",
  "productName": "AMR Trak",
  "version": "1.0.0",
  "description": "AMR Trak desktop (offline data entry)",
  "main": "main.js",
  "author": "Saad",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "prepare-app": "node scripts/prepare.js",
    "start": "npm run prepare-app && electron .",
    "dist": "npm run prepare-app && electron-builder --win --publish never",
    "release": "npm run prepare-app && electron-builder --win --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "chart.js": "^4.4.7",
    "datatables.net": "1.13.6",
    "datatables.net-buttons": "2.4.1",
    "datatables.net-buttons-dt": "2.4.1",
    "datatables.net-dt": "1.13.6",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "file-saver": "2.0.5",
    "firebase": "10.8.0",
    "jquery": "3.7.0",
    "jszip": "3.10.1",
    "select2": "4.1.0-rc.0",
    "sweetalert2": "^11.14.5",
    "tailwindcss": "^3.4.17",
    "xlsx": "0.18.5",
    "xlsx-populate": "1.21.0"
  },
  "build": {
    "appId": "iq.amrtrak.desktop",
    "productName": "AMR Trak",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "app/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "shortcutName": "AMR Trak"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "BasraCliniciansApps",
        "repo": "AMR-Trak",
        "releaseType": "release"
      }
    ]
  }
}
